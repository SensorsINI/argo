[Unit]
Description=Shutdown Timing Logger
Documentation=man:systemd.service(5)
DefaultDependencies=no
# Run EARLY in shutdown, before most services stop
# This allows us to monitor the actual stop times
Before=shutdown.target reboot.target poweroff.target halt.target
After=argo_launch_standard.service argo_power_control.service argo_battery_water.service

[Service]
Type=oneshot
# Monitor shutdown in real-time and log service stop times
ExecStart=/usr/local/bin/shutdown-logger.sh
StandardOutput=journal
StandardError=journal
# Give it plenty of time to monitor the shutdown process
TimeoutStartSec=90
RemainAfterExit=yes

[Install]
# This service is triggered when shutdown begins
WantedBy=shutdown.target reboot.target poweroff.target halt.target
