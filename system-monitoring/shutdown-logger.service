[Unit]
Description=Shutdown Event Logger
Documentation=man:systemd.service(5)
DefaultDependencies=no
Before=shutdown.target poweroff.target halt.target
After=final.target

# This service runs early in shutdown to capture service stop times
# It must run BEFORE services start stopping so we can query their state
Conflicts=reboot.target
Conflicts=poweroff.target
Conflicts=halt.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/shutdown-logger.sh
StandardOutput=journal
StandardError=journal
# Don't wait for this to complete - it logs asynchronously
TimeoutStartSec=5
# Ensure we run even if other services fail
RemainAfterExit=no

[Install]
WantedBy=shutdown.target poweroff.target halt.target




