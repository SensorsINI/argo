alias j=autojump
alias relogin="source ~/.bashrc"
alias vimlogin="vim ~/.bashrc && relogin"
alias vimaliases="vim ~/.bash_aliases && relogin"
alias d=pushd
alias u=popd
alias lrt="ls -lhrt"
alias filecount="ls -1|wc -l"
alias cdsensorsini='cd ~/Dropbox/GitHub/SensorsINI'
alias df1="df | egrep '^/'"
alias df2='df -x tmpfs -x efivarfs '
alias mount1="mount | grep -E '^/'|grep -v snapd"


# Argo Robot Control Aliases - Improved ROS2 Native Approach
alias akill='$ARGO_DIR/scripts/akill.sh'
alias al='$ARGO_DIR/launch/argo_start_standard.sh'      # Start Argo nodes using standard launch
alias aq='$ARGO_DIR/launch/argo_stop_standard.sh'       # Stop Argo nodes using standard launch
alias ars='aq && al' # Restart Argo nodes
alias as='python3 $ARGO_DIR/launch/argo_lifecycle_manager.py status'      # Show Argo status (restored rich output)
alias asq='python3 $ARGO_DIR/launch/argo_lifecycle_manager.py quick_status --quiet'  # Quick status (restored rich output)
alias am='$ARGO_DIR/launch/argo_monitor.sh'  # Monitor mode - continuous status display
alias ap='if systemctl is-active --quiet argo_launch_standard.service; then current_state=$(timeout 5 ros2 service call /controller_node/pause std_srvs/srv/SetBool "data: null" 2>/dev/null | grep -o "paused\|unpaused" || echo "unknown"); if [ "$current_state" = "paused" ]; then timeout 5 ros2 service call /controller_node/pause std_srvs/srv/SetBool "data: false" && echo "✅ Controller UNPAUSED - autonomous control resumed" || echo "❌ Failed to unpause controller"; else timeout 5 ros2 service call /controller_node/pause std_srvs/srv/SetBool "data: true" && echo "✅ Controller PAUSED - human control takes over" || echo "❌ Failed to pause controller"; fi; else echo "❌ Error: argo_launch_standard.service is not running"; echo "   Start it first with: al (or: sudo systemctl start argo_launch_standard.service)"; fi'  # Toggle controller pause state
alias ar='if systemctl is-active --quiet argo_launch_standard.service; then timeout 30 ros2 service call /argo/recording/start std_srvs/srv/Trigger; else echo "❌ Error: argo_launch_standard.service is not running"; echo "   Start it first with: al (or: sudo systemctl start argo_launch_standard.service)"; fi'  # Start recording
alias ac='if systemctl is-active --quiet argo_launch_standard.service; then timeout 30 ros2 service call /argo/recording/stop std_srvs/srv/Trigger; else echo "❌ Error: argo_launch_standard.service is not running"; echo "   Start it first with: al (or: sudo systemctl start argo_launch_standard.service)"; fi'   # Stop recording
alias ah='bash $ARGO_DIR/launch/argo_help.sh' # show argo help
alias ag='sudo python3 $ARGO_DIR/launch/argo_gui.py' # start argo gui
alias alog='$ARGO_DIR/scripts/argo_logs.sh' # show argo system logs
alias asim='python3 $ARGO_DIR/launch/argo_lifecycle_manager.py simulate_local' # start argo in LOCAL simulation mode (uses lifecycle manager with validation)
alias asimreset='source /opt/ros/humble/setup.bash && ros2 service call /simulator/reset std_srvs/srv/Trigger' # reset simulation to origin home location on map
alias asimkb='argo_keyboard_control.py'
alias asimlog='tail -f $ARGO_DIR/logs/simulation_*.log | tail -1' # view latest simulation log (use with: tail -f $(ls -t $ARGO_DIR/logs/simulation_*.log | head -1))
alias asimlatest='ls -t $ARGO_DIR/logs/simulation_*.log 2>/dev/null | head -1' # get path to latest simulation log
alias cleanbags='find $ARGO_DIR/bags -type f -mtime +3 -exec rm -f {} \;' # clean old bags
alias apb='bash $ARGO_DIR/scripts/argo_playback_latest.sh' # Play back latest recording with visualization
alias arr='bash $ARGO_DIR/scripts/argo_rerecord_bag.sh' # Re-record latest recording with visualization markers
# handy shutdown and reboot aliases with confirmation
alias sd='read -p "Shutdown now? (y/N): " -n 1 -r; echo; if [[ $REPLY =~ ^[Yy]$ ]]; then sudo shutdown now; fi'
alias rb='read -p "Reboot now? (y/N): " -n 1 -r; echo; if [[ $REPLY =~ ^[Yy]$ ]]; then sudo reboot; fi'

# X11 forwarding setup for VSCode Remote-SSH
alias ax11='source ~/auto_detect_x11.sh'  # Auto-detect and setup X11 forwarding

# vacuum logs and tmp to free up zram space
alias vacuum='sudo journalctl --vacuum-size=10M ;sudo find /tmp -type f -atime +2 -delete 2>/dev/null && sudo find /tmp -type d -empty -delete 2>/dev/null && echo "Cleaned /tmp"'
