
# Determine Argo repository directory dynamically
# This allows the dotfiles to work regardless of where the repo is cloned.
if [ -z "$ARGO_DIR" ]; then
    # Get the directory of this script, resolving symlinks
    ARGO_DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    # The Argo directory is one level up from the dotfiles directory
    export ARGO_DIR="$(dirname "$ARGO_DOTFILES_DIR")"
fi

source "$ARGO_DIR/dotfiles/bash_aliases"

# Enable bash completion for Argo Python scripts
if [ -f "$ARGO_DIR/dotfiles/.bash_completion_argo" ]; then
    source "$ARGO_DIR/dotfiles/.bash_completion_argo"
fi

# Run Argo shutdown status check once per terminal session
# This provides critical battery and shutdown information for both SSH and desktop terminals
if [[ -z "$ARGO_MOTD_SHOWN" ]]; then
    export ARGO_MOTD_SHOWN=1
    # Check if the shutdown status script exists
    if [[ -f "$ARGO_DIR/scripts/15-argo-shutdown-status" ]]; then
        bash "$ARGO_DIR/scripts/15-argo-shutdown-status"
    fi
fi

argo_status() {
    python3 "$ARGO_DIR/launch/argo_lifecycle_manager.py" status
}

argo_quick_status() {
    python3 "$ARGO_DIR/launch/argo_lifecycle_manager.py" quick_status
}

# Quick timer for automatic status checks
argo_quick_timer() {
    local force_check=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -f|--force)
                force_check=true
                shift
                ;;
            *)
                echo "Usage: argo_quick_timer [-f|--force]"
                echo "  -f, --force    Force status check regardless of timer"
                return 1
                ;;
        esac
    done
    
    # Check if quick timer should run (5+ minutes since last check)
    local last_check_file="$HOME/.argo_last_check"
    local current_time=$(date +%s)
    local last_check_time=0
    
    if [ -f "$last_check_file" ]; then
        last_check_time=$(cat "$last_check_file" 2>/dev/null || echo "0")
    fi
    
    local time_diff=$((current_time - last_check_time))
    
    # Run check if forced or if it's been more than 5 minutes (300 seconds)
    if [ "$force_check" = true ] || [ $time_diff -ge 300 ]; then
        # Show "please wait" message that can be aborted by pressing Enter
        echo -n "🔍 Checking Argo status (press Enter to skip)..."
        
        # Check if Enter is pressed within short timeout
        if read -t 1.0 -r; then
            # User pressed Enter - abort check
            echo -ne "\r\033[K"  # Clear the line
            return 0
        fi
        
        # Clear the "please wait" message before showing status
        echo -ne "\r\033[K"
        
        # Show condensed status using the new standard status script
        python3 "$ARGO_DIR/launch/argo_lifecycle_manager.py" quick_status
        
        # IMPORTANT: Update the timestamp *after* the check is done
        echo "$(date +%s)" > "$last_check_file"
    fi
}

# For this to work, you will need to install autojump first.
# It is available on most package managers.
# For example:
#   Debian/Ubuntu: sudo apt install autojump
#   Arch: sudo pacman -S autojump
#   etc.
[ -f /usr/share/autojump/autojump.sh ] && . /usr/share/autojump/autojump.sh

# Set ROS_DOMAIN_ID for consistent ROS2 communication
export ROS_DOMAIN_ID=0

PATH="$ARGO_DIR/launch:$ARGO_DIR/nodes:$ARGO_DIR/scripts:$ARGO_DIR/power_control:$PATH"

# Add argo_quick_timer to PROMPT_COMMAND for continuous status monitoring
# This will check status before each prompt (throttled to 5-minute intervals)
PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND; }argo_quick_timer"
