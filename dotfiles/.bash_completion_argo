#!/usr/bin/env bash
# Argo CLI Tab Completion
# This file provides bash completion for Argo Python scripts

# Enable global python-argcomplete for user (no sudo required)
# This allows tab completion for any Python script with argcomplete enabled
if [ ! -f ~/.bash_completion.d/python-argcomplete.sh ]; then
    # Install global argcomplete for user if not already installed
    if command -v activate-global-python-argcomplete3 &> /dev/null; then
        activate-global-python-argcomplete3 --user &> /dev/null || true
    elif command -v activate-global-python-argcomplete &> /dev/null; then
        activate-global-python-argcomplete --user &> /dev/null || true
    fi
fi

# Source the user-level global argcomplete if available
if [ -f ~/.bash_completion.d/python-argcomplete.sh ]; then
    source ~/.bash_completion.d/python-argcomplete.sh
fi

# Note: For tab completion to work, Python scripts need these 3 elements:
#   1. #!/usr/bin/env python3 (shebang line)
#   2. # PYTHON_ARGCOMPLETE_OK (marker for global argcomplete detection)
#   3. import argcomplete + argcomplete.autocomplete(parser) (in code)
#
# Once configured, completion works for BOTH invocation methods:
#   - python3 script.py --<TAB>  (global argcomplete detects marker in script)
#   - ./script.py --<TAB>         (global argcomplete detects marker in executable)
#
# Use scripts/add_argcomplete_to_script.sh to add all required elements automatically!

