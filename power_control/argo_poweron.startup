#!/usr/bin/bash

# argo_poweron.startup
# ---------------------------------
# Purpose:
#   Early boot hook to assert Orange Pi Zero 2W pin PI3 (GPIO line 259)
#   LOW during normal operation so the external power relay remains
#   energized. Also flashes green LED (line 228) 3 times as visual 
#   confirmation that startup is complete and user can release power button.
#   This runs once at boot and exits.
#
# Notes:
#   - Keep minimal dependencies. Prefer Python libgpiod; fallback to gpioset.
#   - We set the power line to output LOW (open-drain if using Python).
#   - Green LED is flashed 3 times quickly (~1 second total) then released.
#   - On this system, pin configuration persists after the process exits.
#   - Exit 0 regardless to avoid blocking boot.

set -euo pipefail

if command -v python3 >/dev/null 2>&1; then
python3 - <<'PY'
import gpiod
import time

chip = gpiod.Chip("/dev/gpiochip0")

# Set up power control line (259) - keep power relay energized
power_line = chip.get_line(259)
power_line.request(
    consumer="startup",
    type=gpiod.LINE_REQ_DIR_OUT,
    flags=gpiod.LINE_REQ_FLAG_OPEN_DRAIN,
    default_vals=[0]
)

# Set up green LED line (228) for visual confirmation
green_led_line = chip.get_line(228)
green_led_line.request(
    consumer="startup_led",
    type=gpiod.LINE_REQ_DIR_OUT,
    default_vals=[0]
)

# Flash green LED 3 times quickly (within 1 second total)
for i in range(3):
    green_led_line.set_value(1)  # LED on
    time.sleep(0.15)             # 150ms on
    green_led_line.set_value(0)  # LED off
    time.sleep(0.15)             # 150ms off (300ms per cycle, ~1 second total)

# Release green LED line so power_control can take over
green_led_line.release()

# Power line state persists after we exit (open-drain configuration)
PY
    exit 0
fi

if command -v gpioset >/dev/null 2>&1; then
    # Fallback: drive power line LOW and flash green LED 3 times
    gpioset gpiochip0 259=0
    
    # Flash green LED 3 times for visual confirmation
    for i in {1..3}; do
        gpioset gpiochip0 228=1  # LED on
        sleep 0.15
        gpioset gpiochip0 228=0  # LED off
        sleep 0.15
    done
    exit 0
fi

exit 0


