#!/usr/bin/bash

# argo_poweroff.shutdown
# ---------------------------------
# Purpose:
#   Late shutdown hook invoked by systemd in the system-shutdown phase.
#   It asserts Orange Pi Zero 2W pin PI3 (GPIO line 259) briefly to
#   signal the external power control to cut power. This should be one
#   of the last actions before the kernel powers off.
#
# Invocation:
#   Placed at /lib/systemd/system-shutdown/argo_poweroff (installed by Makefile).
#   systemd runs scripts here with a single argument indicating mode:
#   { poweroff | reboot | halt | kexec }. We only run power-off sequence
#   for poweroff and halt modes, not for reboot or kexec.
#   A short GPIO buzzer pulse runs at the start for every mode (including reboot)
#   so shutdown is audible before any mode-specific path exits.
#
# Notes:
#   - Minimal dependencies: do not rely on any systemd services.
#   - Prefer Python libgpiod if available; otherwise fall back to gpioset.
#   - Keep the pulse short; external circuit should cut power quickly.
#   - Exit 0 regardless, to never block shutdown.
# 
# The hook is working correctly in rev4 argo PCB board.


set -euo pipefail

MODE="${1:-}"
MODE_LC="$(printf '%s' "$MODE" | tr '[:upper:]' '[:lower:]')"
# Duration (seconds) for the buzzer at the start of every shutdown/reboot.
START_BUZZ_SEC=0.2

# Persistent log file for shutdown hook.
# During a real poweroff/reboot this directory is often already remounted
# read-only before systemd runs system-shutdown scripts, so no file may appear
# here. Console, /dev/kmsg, and logger (below) are the reliable trails; for a
# prior boot try: journalctl -b -1 | grep argo_poweroff
PERSIST_DIR="/var/log.hdd/persistent"
PERSIST_LOG="$PERSIST_DIR/shutdown-hook-$(date +%Y%m%d-%H%M%S).log"

# Ensure persistent directory exists (critical for logging)
mkdir -p "$PERSIST_DIR" 2>/dev/null || true

# Console logging helper (postfix with 50 * and pause 1s)
STARS="**************************************************"
c_echo() {
    local msg="$(date): argo_poweroff: $* $STARS"
    # Always log to console first (most reliable during shutdown)
    echo "$msg" > /dev/console 2>/dev/null || true
    # Also log to kernel message buffer for dmesg visibility
    echo "$msg" > /dev/kmsg 2>/dev/null || true
    # journald may still accept messages early in shutdown (best-effort).
    command -v logger >/dev/null 2>&1 && logger -t argo_poweroff --priority daemon.notice -- "$msg" 2>/dev/null || true
    # Persistent append: often fails silently when $PERSIST_DIR is read-only (do not use -w; it skips all writes).
    if [ -d "$PERSIST_DIR" ]; then
        echo "$msg" >> "$PERSIST_LOG" 2>/dev/null || {
            mkdir -p "$PERSIST_DIR" 2>/dev/null && echo "$msg" >> "$PERSIST_LOG" 2>/dev/null || true
        }
    fi
    sleep .1
}

# Short buzzer on GPIO 258 (PI2), active HIGH. Best-effort; never fails shutdown.
# Optional duration in seconds (default 0.2).
buzzer_pulse() {
    local dur="${1:-0.2}"
    if ! command -v python3 >/dev/null 2>&1; then
        return 0
    fi
    export _ARGO_BUZZ_SEC="$dur"
    python3 <<'PY' || true
import os
import sys
import time

try:
    import gpiod
except Exception:
    sys.exit(0)

sec = float(os.environ.get("_ARGO_BUZZ_SEC", "0.2"))
chip = None
line = None
try:
    chip = gpiod.Chip("/dev/gpiochip0")
    line = chip.get_line(258)  # PI2 buzzer line (active HIGH)
    line.request(consumer="argo_poweroff_buzzer", type=gpiod.LINE_REQ_DIR_OUT, default_vals=[0])
    line.set_value(1)
    time.sleep(sec)
    line.set_value(0)
except Exception:
    pass
finally:
    try:
        if line is not None:
            line.release()
    except Exception:
        pass
    try:
        if chip is not None:
            chip.close()
    except Exception:
        pass
PY
    unset _ARGO_BUZZ_SEC
}

# Announce invocation
c_echo "invoked with args: $* (MODE='${MODE}', mode_lc='${MODE_LC}')"

# If no MODE was provided, do nothing (safety)
if [ -z "${MODE}" ]; then
    c_echo "No MODE argument provided; exiting safely"
    # Give operator a moment to read console
    sleep 2
    exit 0
fi

# Audible cue for any shutdown type (reboot, poweroff, halt, kexec) before mode branches.
c_echo "Startup buzzer pulse (${MODE_LC}), GPIO 258 for ${START_BUZZ_SEC}s"
buzzer_pulse "$START_BUZZ_SEC"

# Check for critical battery flag first
CRITICAL_BATTERY_FLAG="/tmp/argo_critical_battery"
if [ -f "$CRITICAL_BATTERY_FLAG" ]; then
    # Log to both console and kernel log for maximum visibility
    c_echo "╔════════════════════════════════════════════════════════════════╗"
    c_echo "║ CRITICAL BATTERY HALT - PRESERVING POWER FOR MANUAL SAILING    ║"
    c_echo "║ Power relay will remain energized for radio control            ║"
    c_echo "║ System halted due to low battery - radio control is ACTIVE     ║"
    c_echo "╚════════════════════════════════════════════════════════════════╝"
    
    # Also log to kernel ring buffer for dmesg visibility
    echo "**************************************************ARGO CRITICAL BATTERY HALT: Preserving power relay for manual sailing" > /dev/kmsg 2>/dev/null || true
    echo "ARGO CRITICAL BATTERY: Radio control remains active" > /dev/kmsg 2>/dev/null || true
    
    # Give operator time to see the message
    sleep 1
    exit 0
fi

# Only run power-off sequence for actual shutdowns, not reboots
# Be extra conservative - only proceed if we explicitly get 'poweroff' or 'halt'
case "$MODE_LC" in
    poweroff|halt)
        # Proceed with power-off sequence
        c_echo "MODE='${MODE_LC}' -> proceeding with power-off sequence"
        sleep 2
        ;;
    reboot|kexec|*)
        # Skip power-off sequence for reboots, kexec, or any unknown mode
        c_echo "MODE='${MODE_LC}' -> skipping (no power cut)"
        sleep 2
        exit 0
        ;;
esac

# Additional safety check - verify we're not in a reboot scenario
# Check if systemctl is available and if we can determine the target
if command -v systemctl >/dev/null 2>&1; then
    # Check if reboot target is active
    if systemctl list-jobs | grep -q reboot; then
        c_echo "Detected reboot job active -> skipping power cut"
        exit 0
    fi
fi

# Final notice and pause before asserting GPIO so operator can see console
c_echo "Syncing filesystems before power relay cut"
sync || true
sleep 0.5

c_echo "╔══════════════════════════════════════════════════════════════════════════════╗"
c_echo "║ NORMAL SHUTDOWN - CUTTING POWER RELAY by Asserting GPIO 259 to cut power NOW ║"
c_echo "╚══════════════════════════════════════════════════════════════════════════════╝"

# Best-effort buzzer cue before final power cut.
# argo_power_control should have already released GPIO 258 (PI2) by shutdown phase.
c_echo "Best-effort buzzer pulse on GPIO 258 (PI2) for 0.5s before final power cut"
buzzer_pulse 0.5

if command -v python3 >/dev/null 2>&1; then
    c_echo "Using python3 method to assert GPIO 259 HIGH for 0.5s"
python3 - <<'PY'
import gpiod, time
chip = gpiod.Chip("/dev/gpiochip0")
line = chip.get_line(259)
line.request(consumer="shutdown", type=gpiod.LINE_REQ_DIR_OUT)
line.set_value(1)
time.sleep(0.5)
# External circuit will typically remove power immediately after level goes high.
PY
    exit 0
fi

if command -v gpioset >/dev/null 2>&1; then
    c_echo "Using gpioset fallback to assert GPIO 259=1 for 0.5s"
    gpioset gpiochip0 259=1
    c_echo "gpioset executed; sleeping 0.5s"
    sleep 0.5
    exit 0
fi

c_echo "No GPIO method available; nothing to do"

exit 0
