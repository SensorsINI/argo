[Unit]
Description=Argo Power Control System
Documentation=file://%h/argo/launch/ARGO_POWER_CONTROL_README.md
After=basic.target sysinit.target argo_poweron.service
Wants=basic.target
DefaultDependencies=no
Before=shutdown.target

[Service]
Type=simple
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/argo/power_control
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && /usr/bin/python3 /home/orangepi/argo/power_control/argo_power_control.py'
ExecStop=/bin/bash -c 'echo "System shutting down - GPIO pins will automatically revert to input state, de-energizing relay..."'
Restart=no
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL

# Security settings
NoNewPrivileges=false
PrivateTmp=false

[Install]
WantedBy=basic.target
