[Unit]
Description=Argo Power Control System
After=multi-user.target network.target
Documentation=file:///root/argo/launch/ARGO_POWER_CONTROL_README.md

[Service]
Type=simple
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/argo/power_control
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && /usr/bin/python3 /home/orangepi/argo/power_control/argo_power_control.py'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
