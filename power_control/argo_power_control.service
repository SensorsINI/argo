[Unit]
Description=Argo Power Control System
After=network.target
Wants=argo_battery_water.service
Documentation=file:///root/argo/launch/ARGO_POWER_CONTROL_README.md

[Service]
Type=simple
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/argo/power_control
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/mkdir -p /var/log.hdd/persistent
ExecStart=/bin/bash -c 'set -eo pipefail; source /opt/ros/humble/setup.bash && /usr/bin/python3 /home/orangepi/argo/power_control/argo_power_control.py |& tee -a /var/log.hdd/persistent/argo-power-control.log'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
