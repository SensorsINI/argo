[Unit]
Description=Argo Power Control System
After=argo_ph0_input.service network.target
Wants=argo_battery_water.service
Documentation=file:///root/argo/launch/ARGO_POWER_CONTROL_README.md

[Service]
Type=simple
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/argo/power_control
Environment=PYTHONUNBUFFERED=1
# Release early PH0 holder so this service can request GPIO 224 for button interrupts.
ExecStartPre=+-/bin/systemctl stop argo_ph0_input.service
ExecStartPre=/bin/mkdir -p /var/log.hdd/persistent
# CRITICAL: Clear Python bytecode cache to prevent running stale code with syntax errors
ExecStartPre=/bin/bash -c 'find /home/orangepi/argo/power_control -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true; find /home/orangepi/argo/power_control -name "*.pyc" -delete 2>/dev/null || true'
# CRITICAL: Validate Python syntax before starting - fail fast if syntax is invalid
ExecStartPre=/bin/bash -c 'source /opt/ros/humble/setup.bash && /usr/bin/python3 -m py_compile /home/orangepi/argo/power_control/argo_power_control.py'
# Source launch/argo.env for RCUTILS_LOGGING_USE_STDOUT=1 so rclpy logs reach tee (not only ~/.ros/log/)
ExecStart=/bin/bash -c 'set -eo pipefail; source /opt/ros/humble/setup.bash && source /home/orangepi/argo/launch/argo.env && exec /usr/bin/python3 /home/orangepi/argo/power_control/argo_power_control.py |& tee -a /var/log.hdd/persistent/argo-power-control.log'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=30
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL

[Install]
WantedBy=multi-user.target
