[Unit]
Description=ROS2 Test Service Client
After=network.target test-service-server.service
Wants=network.target
Requires=test-service-server.service

[Service]
Type=oneshot
User=tobi
Group=tobi
WorkingDirectory=/home/tobi/Dropbox/GitHub/SensorsINI/argo/tests
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && /usr/bin/python3 /home/tobi/Dropbox/GitHub/SensorsINI/argo/tests/test_service_client.py'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=test-service-client
TimeoutStartSec=30

# Environment variables
Environment=ROS_DOMAIN_ID=0
Environment=PYTHONPATH=/opt/ros/humble/lib/python3.10/site-packages:/home/tobi/Dropbox/GitHub/SensorsINI/argo

[Install]
WantedBy=multi-user.target
