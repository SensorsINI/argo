[Unit]
Description=Argo Health Monitor Service
Documentation=file://%h/argo/launch/argo_health_monitor.py
After=network.target
Before=argo_launch_standard.service
Wants=network.target

[Service]
Type=simple
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/argo/launch
Environment=ROS_DOMAIN_ID=0
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/mkdir -p /var/log.hdd/persistent
# CRITICAL: Clear Python bytecode cache to prevent running stale code with syntax errors
ExecStartPre=/bin/bash -c 'find /home/orangepi/argo/launch -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true; find /home/orangepi/argo/launch -name "*.pyc" -delete 2>/dev/null || true'
# CRITICAL: Validate Python syntax before starting - fail fast if syntax is invalid
ExecStartPre=/bin/bash -c 'source /opt/ros/humble/setup.bash && /usr/bin/python3 -m py_compile /home/orangepi/argo/launch/argo_health_monitor.py'
ExecStart=/bin/bash -c 'set -eo pipefail; source /opt/ros/humble/setup.bash && exec /usr/bin/python3 /home/orangepi/argo/launch/argo_health_monitor.py |& tee -a /var/log.hdd/persistent/argo-health-monitor.log'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=15
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL

[Install]
WantedBy=multi-user.target
