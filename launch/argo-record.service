[Unit]
Description=Argo Robot ROS2 Bag Recording Service
After=network.target
Wants=argo-launch.service

[Service]
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/bagfiles
EnvironmentFile=/home/orangepi/argo/launch/argo.env
ExecStart=/bin/bash -l -c 'source /opt/ros/humble/setup.bash && ros2 bag record -a -o argo_$(date +%%Y%%m%%d_%%H%%M%%S)'
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
# WantedBy=multi-user.target
# Uncomment above line to enable automatic startup