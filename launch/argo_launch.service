[Unit]
Description=Argo Robot ROS2 Launch Service
After=network.target
Wants=argo_radio_servo_module.service

[Service]
Type=simple
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/argo
EnvironmentFile=/home/orangepi/argo/launch/argo.env
Environment=ROS_DOMAIN_ID=0
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && python3 launch/argo_lifecycle_manager.py run'
ExecStop=/bin/bash -c 'source /opt/ros/humble/setup.bash && python3 launch/argo_lifecycle_manager.py stop'
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target