[Unit]
Description=Argo BNO085 IMU Sensor Service
Documentation=file://%h/argo/nodes/README_BNO085.md
After=basic.target sysinit.target
Wants=basic.target
DefaultDependencies=no
Before=argo_launch.service shutdown.target

[Service]
Type=simple
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/argo/nodes
Environment=ROS_DOMAIN_ID=0
ExecStart=/home/orangepi/argo/nodes/bno085_driver_launcher.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=10
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL

# Security settings
NoNewPrivileges=false
PrivateTmp=false

[Install]
WantedBy=basic.target


