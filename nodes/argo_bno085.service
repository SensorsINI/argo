[Unit]
Description=Argo BNO085 IMU Driver Service
Documentation=file://%h/argo/nodes/README_BNO085.md
After=network.target
DefaultDependencies=no
Before=argo_launch_standard.service shutdown.target

[Service]
Type=simple
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/argo/nodes
Environment=ROS_DOMAIN_ID=0
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/mkdir -p /var/log.hdd/persistent
ExecStart=/bin/bash -c 'set -eo pipefail; /home/orangepi/argo/nodes/bno085_driver_launcher.sh |& tee -a /var/log.hdd/persistent/argo-bno085.log'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=10
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL

# Security settings
NoNewPrivileges=false
PrivateTmp=false

[Install]
WantedBy=multi-user.target
