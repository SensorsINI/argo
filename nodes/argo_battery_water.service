[Unit]
Description=Argo Battery and Water Monitoring Service
Documentation=file://%h/argo/nodes/argo_battery_water.py
After=network.target argo_bno085.service
Wants=argo_bno085.service
# REMOVED: DefaultDependencies=no and Before=shutdown.target
# These caused 60-90 second shutdown hangs because the service tried to
# shut down gracefully after ROS2 infrastructure was already dead.
# Service now stops normally (< 1 second) when ROS2 is still alive.

[Service]
Type=simple
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/argo/nodes
Environment=ROS_DOMAIN_ID=0
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/mkdir -p /var/log.hdd/persistent
ExecStartPre=/bin/bash /home/orangepi/argo/scripts/wait_for_bno085_ready.sh
# CRITICAL: Clear Python bytecode cache to prevent running stale code with syntax errors
ExecStartPre=/bin/bash -c 'find /home/orangepi/argo/nodes -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true; find /home/orangepi/argo/nodes -name "*.pyc" -delete 2>/dev/null || true'
# CRITICAL: Validate Python syntax before starting - fail fast if syntax is invalid
ExecStartPre=/bin/bash -c 'source /opt/ros/humble/setup.bash && /usr/bin/python3 -m py_compile /home/orangepi/argo/nodes/argo_battery_water.py'
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && exec /usr/bin/python3 /home/orangepi/argo/nodes/argo_battery_water.py'
Restart=always
RestartSec=5
StandardOutput=append:/var/log.hdd/persistent/argo-battery-water.log
StandardError=append:/var/log.hdd/persistent/argo-battery-water.log
TimeoutStopSec=10
KillMode=control-group
KillSignal=SIGTERM
KillSignal=SIGTERM
FinalKillSignal=SIGKILL

# Security settings
NoNewPrivileges=false
PrivateTmp=false

[Install]
WantedBy=multi-user.target
