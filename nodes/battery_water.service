[Unit]
Description=Argo Battery and Water Monitoring Service
Documentation=file://%h/argo/nodes/battery_water.py
After=basic.target sysinit.target
Wants=basic.target
DefaultDependencies=no
Before=argo-launch.service shutdown.target

[Service]
Type=simple
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/argo/nodes
Environment=ROS_DOMAIN_ID=0
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && /usr/bin/python3 /home/orangepi/argo/nodes/battery_water.py'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL

# Security settings
NoNewPrivileges=false
PrivateTmp=false

[Install]
WantedBy=basic.target





