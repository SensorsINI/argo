## Error Handling Patterns

### Simulator Initialization Errors
```python
try:
    # Initialize real simulator
    self.sim_manager = Manager(...)
except Exception as e:
    import traceback
    self.get_logger().warn(f'Failed to initialize real simulator: {e}')
    tb_str = ''.join(traceback.format_exception(type(e), e, e.__traceback__))
    self.get_logger().warn(f'Stack trace for simulator initialization failure:\n{tb_str}')
    # Fallback to mock
    self.simulator = MockSailboatSimulator()
```

### Import Path Management
```python
# Add simulator submodule to Python path
simulator_path = os.path.join(os.path.dirname(os.path.dirname(__file__)), 'simulator')
if simulator_path not in sys.path:
    sys.path.insert(0, simulator_path)
```

## Simulation Loop Patterns

### Main Simulation Step
```python
def local_simulation_step(self):
    try:
        # Generate mock human input (optional)
        if self.mock_human_input and self.human_controlled:
            self.publish_mock_human_input()
        
        # Update simulator physics
        if self.use_mock:
            self.boat_state = self.simulator.step()
        else:
            # Real sailboat-playground API
            self.sim_manager.step([sail_angle, rudder_angle])
            state = self.sim_manager.agent_state
            self.boat_state = self._convert_state(state)
        
        # Publish sensor data
        self.publish_sensor_data()
    except Exception as e:
        self.get_logger().error(f'Simulation step error: {e}')
```

### Control Command Handling
```python
def control_callback(self, msg):
    rudder = msg.x  # -1 to +1
    sail = msg.y    # -1 to +1
    
    if self.use_mock:
        self.simulator.set_control(rudder, sail)
    else:
        # Convert to degrees for sailboat-playground
        self.last_rudder_angle = rudder * 30.0  # -30 to +30 degrees
        self.last_sail_angle = sail * 45.0      # -45 to +45 degrees
```

## Data Publishing Patterns

### Sensor Data Conversion
```python
def publish_sensor_data(self):
    # IMU/Compass data (heading in degrees)
    pose_msg = Vector3(x=0.0, y=0.0, z=self.boat_state['heading'])
    self.pub_pose.publish(pose_msg)
    
    # GPS data (convert m/s to knots)
    speed_knots = self.boat_state['speed'] * 1.94384
    gps_sog_msg = Float64(data=speed_knots)
    self.pub_gps_sog.publish(gps_sog_msg)
    
    # Wind data
    wind_msg = Vector3(
        x=self.boat_state['wind_speed'],     # m/s
        y=self.boat_state['wind_direction'], # degrees relative to boat
        z=22.5                               # temperature (mock)
    )
    self.pub_wind.publish(wind_msg)
```

### Mock Human Input Generation
```python
def publish_mock_human_input(self):
    self.human_input_time += 1.0 / self.simulation_rate
    
    # Generate human-like control input
    rudder = 0.3 * math.sin(self.human_input_time * 0.5)
    sail = 0.2 + 0.2 * math.cos(self.human_input_time * 0.3)
    
    radio_msg = Vector3(x=rudder, y=sail, z=0.0)
    self.pub_radio.publish(radio_msg)
```

## Launch Patterns

### Lifecycle Manager Integration
```python
def simulate(self) -> bool:
    # Define simulation mode node scripts (exclude conflicting hardware nodes)
    self.expected_nodes = [
        "argo_unified_simulator_bridge.py",  # Provides simulated sensor data
        "controller.py",                     # Autonomous navigation
        "battery_water.py",                  # Hardware monitoring
        "temp_monitor.py"                    # Hardware monitoring
    ]
    
    # Critical nodes for simulation
    self.critical_nodes = ["argo_unified_simulator_bridge.py", "controller.py"]
    
    # Launch simulation nodes
    self._launch_nodes_directly()
```

### Launch Script Pattern
```bash
#!/bin/bash
# Launch Argo Unified Simulator Bridge in local mode

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ARGO_DIR="$(dirname "$SCRIPT_DIR")"

# Source ROS2 environment
source /opt/ros/humble/setup.bash

# Run the unified simulator bridge in local mode
python3 "$ARGO_DIR/nodes/argo_unified_simulator_bridge.py" --mode local
```

