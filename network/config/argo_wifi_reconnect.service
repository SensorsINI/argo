[Unit]
Description=Argo WiFi Reconnection Service
# Authoritative doc on disk: network/README.md (repo root). file:// not used here — Windows + Remote SSH resolves it as a local path. GitHub URL is for systemctl and portable links.
Documentation=https://github.com/SensorsINI/argo/blob/master/network/README.md
After=network-online.target NetworkManager.service
Wants=network-online.target
Requires=NetworkManager.service

[Service]
Type=oneshot
# Run as root to ensure log file permissions are handled correctly after rotation
User=root
Group=root
ExecStart=/home/orangepi/argo/network/scripts/wifi_reconnect.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=argo-wifi-reconnect
TimeoutStopSec=30

# Set environment for proper operation
Environment="HOME=/home/orangepi"
Environment="USER=orangepi"

# Restart policy - run every minute
Restart=no
RestartSec=60

# Timer configuration
[Install]
WantedBy=multi-user.target
